# Existing MongoDB connection used by the NestJS app.
MONGODB_DATABASE_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/DATABASE

# Existing FastAPI embedding service. Do not put this in the mobile app.
# EMBEDDING_API is also used by the existing GenAI module. EMBEDDING_API_URL
# is supported as an optional alias by the knowledge-base module.
EMBEDDING_API=http://127.0.0.1:8000

# Existing Qdrant deployment used by the embedding API. Required only for
# GET /knowledge-base/documents/:documentId/chunks.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=documents

# AWS S3 upload configuration. Use an IAM role in AWS, or credentials only in local development.
AWS_REGION=dummy
AWS_S3_KNOWLEDGE_BASE_BUCKET=dummy
AWS_ACCESS_KEY_ID=dummy
AWS_SECRET_ACCESS_KEY=dummy
